# Fitness Phyre - Apache settings (works on normal shared PHP hosting)

# Never list folder contents
Options -Indexes

# Friendly 404 page. (If the site lives in a sub-folder, change to /your-folder/404.php)
ErrorDocument 404 /404.php

# ---- HTTPS ---------------------------------------------------------------
# After your SSL certificate is working, remove the leading # from the 3 lines below
# so everyone is sent to the secure https:// version.
#RewriteEngine On
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct web access to SQL dumps, docs, logs and sample files
<FilesMatch "\.(sql|md|log|sample\.php|gitignore)$">
    Require all denied
</FilesMatch>

# Basic security headers (PHP pages also send these themselves, plus a Content-Security-Policy)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Clean URLs: /about works as well as /about.php ; /sitemap.xml is generated by sitemap.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-z\-]+)$ $1.php [L]
</IfModule>

# Compress text files (faster on mobile data)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Cache static files for a month. asset() adds ?v=<time> so changed files still refresh.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
